# HABEAS configuration — copy to .env and fill in. Never commit .env.
# The demo-safe graph prefix "HABEAS_demo" is hard-coded (PLAN.md §6):
# destructive seed reset is refused for any other graph name.

FALKORDB_HOST=localhost
FALKORDB_PORT=6379
GRAPH_NAME=HABEAS_demo_local
# true = simulated actions (freeze) are allowed on the demo graph
HABEAS_DEMO_MODE=true
# FalkorDB per-query timeout in MILLISECONDS
FALKORDB_QUERY_TIMEOUT_MS=10000

# LLM_MODE=fake runs the deterministic FakeLLM path offline (no API key).
# LLM_MODE=real requires credentials for the selected LLM_PROVIDER.
LLM_MODE=fake
# openai (default) or groq. Groq uses its OpenAI-compatible endpoint with
# GROQ_API_KEY; OPENAI_API_KEY is never repurposed for Groq.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GROQ_API_KEY=
# Groq tool-calling model, e.g. openai/gpt-oss-120b or llama-3.3-70b-versatile
GROQ_MODEL=
# Optional: generic model fallback used when the provider-specific var is empty
LLM_MODEL=

TOOL_BUDGET=12
